{
  "name": "kaykay",
  "version": "0.3.0",
  "description": "A Svelte 5 flow/node editor library with typed port connections",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "USAGE.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package",
    "ci": "pnpm check && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "oxlint": "^1.81.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "flow",
    "node-editor",
    "graph",
    "diagram"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rakunlabs/kaykay"
  }
}
